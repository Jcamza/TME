# Edit paths for your own server; activate your existing official NegLabel environment.
OFFICIAL_ROOT=/data/hx/code/NegLabel
GPU=0
BATCH_SIZE=16
VIEW_BATCH_SIZE=32
WORKERS=2
ALPHA_GRID=0.2
FUSION=feature
CROP_MODE=fivecrop
OUTPUT_DIR=results/neglab_compare_fivecrop
